{
  "name": "wacrm-platform",
  "version": "1.0.0",
  "description": "Multi-Tenant WhatsApp CRM and Branch Management Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/src/app.js",
    "build": "node scripts/build.js",
    "server": "npm run start --workspace=server",
    "server:dev": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "deploy": "npx wrangler deploy",
    "pages:preview": "npm run build && npx wrangler pages dev client/dist",
    "test": "npm run test --workspace=server",
    "test:pg": "npm run test:pg --workspace=server"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "multi-tenant",
    "express",
    "react",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.5.0"
  }
}
