# Server
PORT=5000
NODE_ENV=production
# Allowed browser origin for the API. Use your site URL in production, e.g. https://your-domain.com
CORS_ORIGIN=*

# Multi-User Authentication & Isolation
# Set to true to enforce multi-user registration, OTP verification, login, and tenant workspace isolation
AUTH_REQUIRED=true

# Initial SuperAdmin Credentials (auto-seeded on first run when AUTH_REQUIRED=true)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@WaCRM2026!

# Database: sqlite (default, zero setup) or postgresql (recommended for production)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://wacrm:change-me@127.0.0.1:5432/quickwhatsapp
# DATABASE_SSL=true                 # managed PostgreSQL that requires TLS
# DATABASE_POOL_MAX=10

# Storage Paths
# DATA_DIR=/path/to/persistent/storage
# WA_SESSION_PATH=/path/to/wa_sessions

# Email OTP Delivery (Leave unset to auto-display OTP in console & UI for dev/testing)
# Standard SMTP (Hostinger, Gmail, Zoho, AWS SES):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM="WaCRM Web" <noreply@yourdomain.com>
#
# Or Resend API (https://resend.com):
# RESEND_API_KEY=re_xxxxxxxxx

# SMS Gateway Integration (optional fallback)
# SMS_GATEWAY_URL=https://api.sms-provider.com/send
# SMS_API_KEY=your_sms_api_key

# Public site URL (used for team invitation links), e.g. https://yourdomain.com
# PUBLIC_URL=

# Messaging safeguards (guard rails only; they do not guarantee WhatsApp will not restrict a number)
# WA_SEND_LIMIT_PER_NUMBER_MIN=30
# WA_SEND_LIMIT_PER_NUMBER_HOUR=600
# WA_SEND_LIMIT_PER_MEMBER_MIN=20
# WA_DUPLICATE_WINDOW_SEC=10
# MAX_UPLOAD_MB=32
# INVITE_TTL_HOURS=72

# Security
# SESSION_SECRET=choose-a-strong-secret-key-or-auto-generated-in-db
