# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# WhatsApp Connector Storage
# Directory where branch session files are securely stored. Never commit this folder.
WA_SESSION_PATH=./wa_sessions

# Supabase Configuration
# Server-only credentials. Never expose SUPABASE_SERVICE_ROLE_KEY to client or public repositories.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
