# Server
PORT=5000
NODE_ENV=development
# Allowed browser origin for the API. Use your site URL in production, e.g. https://your-domain.com
CORS_ORIGIN=*

# Optional: where chats (data/), WhatsApp sessions (wa_sessions/) and media (media/) are stored.
# Defaults to the server/ folder. Point this at a persistent disk in production.
# DATA_DIR=/path/to/persistent/disk
# Optional: override only the WhatsApp session folder
# WA_SESSION_PATH=/path/to/wa_sessions
